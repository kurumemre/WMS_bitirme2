@model IEnumerable<WMS_bitirme2.Models.StockMovement>

@{
    ViewData["Title"] = "Stok Hareket Geçmişi";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>📦 Stok Hareket Geçmişi</h1>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Tarih</th>
                    <th>Ürün</th>
                    <th>İşlem Tipi</th>
                    <th>Miktar</th>
                    <th>Raf / Konum</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Tarih.ToString("dd.MM.yyyy HH:mm")</td>

                        <td class="fw-bold text-primary">
                            @Html.DisplayFor(modelItem => item.Product.Ad)
                        </td>

                        <td>
                            @if (item.HareketTipi == WMS_bitirme2.Models.MovementType.Giris)
                            {
                                <span class="badge bg-success">📥 GİRİŞ (Alım/İade)</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">📤 ÇIKIŞ (Satış/Düzeltme)</span>
                            }
                        </td>

                        <td class="fw-bold">@item.Miktar Adet</td>

                        <td>
                            @if (item.Shelf != null)
                            {
                                <span class="badge bg-info text-dark">@item.Shelf.Kod</span>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">- Rafsız İşlem -</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>