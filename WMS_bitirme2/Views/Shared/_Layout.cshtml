<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WMS Depo Yönetimi</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WMS_bitirme2.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-boxes-stacked text-primary"></i> WMS Depo
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark fw-bold" href="#" id="navbarDropdownOps" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                ⚙️ Depo İşlemleri
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdownOps">
                                <li><a class="dropdown-item" asp-controller="PurchaseOrders" asp-action="Index">📥 Mal Kabul (Alım)</a></li>
                                <li><a class="dropdown-item" asp-controller="SalesOrders" asp-action="Index">🚚 Sevkiyat (Satış)</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="StockMovements" asp-action="Index">📊 Stok Hareketleri</a></li>
                                <li><a class="dropdown-item" asp-controller="Transfers" asp-action="Create">⇆ Depolar Arası Transfer</a></li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="navbarDropdownDefs" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                🗂️ Tanımlamalar
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdownDefs">
                                <li><h6 class="dropdown-header">Ürün Yönetimi</h6></li>
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="Index">Ürünler</a></li>
                                <li><a class="dropdown-item" asp-controller="Categories" asp-action="Index">Kategoriler</a></li>
                                <li><a class="dropdown-item" asp-controller="Brands" asp-action="Index">Markalar</a></li>
                                <li><a class="dropdown-item" asp-controller="Units" asp-action="Index">Birimler</a></li>

                                <li><hr class="dropdown-divider"></li>
                                <li><h6 class="dropdown-header">Depo & Lokasyon</h6></li>
                                <li><a class="dropdown-item" asp-controller="Warehouses" asp-action="Index">Depolar</a></li>
                                <li><a class="dropdown-item" asp-controller="Shelves" asp-action="Index">Raflar</a></li>

                                <li><hr class="dropdown-divider"></li>
                                <li><h6 class="dropdown-header">Cari Hesaplar</h6></li>
                                <li><a class="dropdown-item" asp-controller="Suppliers" asp-action="Index">Tedarikçiler</a></li>
                                <li><a class="dropdown-item" asp-controller="Customers" asp-action="Index">Müşteriler</a></li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Users" asp-action="Index">👥 Personel</a>
                        </li>

                    </ul>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - WMS Depo Yönetim Sistemi - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>