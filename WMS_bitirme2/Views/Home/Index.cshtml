@{
    ViewData["Title"] = "Yönetim Paneli";
    // ViewBag'den gelen verileri listeye çeviriyoruz ki döngüye sokabilelim
    var kritikUrunler = ViewBag.KritikUrunler as List<WMS_bitirme2.Models.Product>;
    var sonHareketler = ViewBag.SonHareketler as List<WMS_bitirme2.Models.StockMovement>;
}

<div class="mb-4">
    <h1 class="display-6">📊 Depo Genel Durumu</h1>
    <p class="text-muted">Anlık stok durumu ve hareket özeti.</p>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary mb-3 shadow-sm h-100">
            <div class="card-header">Ürün Çeşidi</div>
            <div class="card-body">
                <h3 class="card-title">@ViewBag.UrunCesidi <span class="fs-6">Kalem</span></h3>
                <p class="card-text"><small>Sistemdeki farklı ürün sayısı</small></p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success mb-3 shadow-sm h-100">
            <div class="card-header">Toplam Stok Adedi</div>
            <div class="card-body">
                <h3 class="card-title">@ViewBag.ToplamStok <span class="fs-6">Adet</span></h3>
                <p class="card-text"><small>Tüm raflardaki toplam mal</small></p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning mb-3 shadow-sm h-100">
            <div class="card-header">Bekleyen Mal Kabul</div>
            <div class="card-body">
                <h3 class="card-title">@ViewBag.BekleyenAlim <span class="fs-6">Sipariş</span></h3>
                <p class="card-text"><small>Depoya girmeyi bekleyenler</small></p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-danger mb-3 shadow-sm h-100">
            <div class="card-header">Bekleyen Sevkiyat</div>
            <div class="card-body">
                <h3 class="card-title">@ViewBag.BekleyenSatis <span class="fs-6">Sipariş</span></h3>
                <p class="card-text"><small>Hazırlanması gereken satışlar</small></p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white fw-bold text-danger border-bottom-0">
                🚨 Kritik Stok Seviyesi (Azalanlar)
            </div>
            <div class="card-body p-0">
                <table class="table table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Ürün Adı</th>
                            <th class="text-center">Kalan Stok</th>
                            <th class="text-end">Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (kritikUrunler != null && kritikUrunler.Any())
                        {
                            foreach (var urun in kritikUrunler)
                            {
                                <tr>
                                    <td>@urun.Ad</td>
                                    <td class="fw-bold text-danger text-center">@urun.StokMiktari</td>
                                    <td class="text-end"><span class="badge bg-danger">Kritik</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-3">Harika! Kritik seviyede ürün yok.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-bold text-primary border-bottom-0">
                ⚡ Son Hareket Akışı
            </div>
            <ul class="list-group list-group-flush">
                @if (sonHareketler != null && sonHareketler.Any())
                {
                    foreach (var hareket in sonHareketler)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-bold text-dark">@hareket.Product?.Ad</span>
                                <div class="text-muted small">@hareket.Tarih.ToString("dd.MM.yyyy HH:mm")</div>
                            </div>

                            @if (hareket.HareketTipi == WMS_bitirme2.Models.MovementType.Giris)
                            {
                                <span class="badge bg-success rounded-pill">+@hareket.Miktar Giriş</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary rounded-pill">-@hareket.Miktar Çıkış</span>
                            }
                        </li>
                    }
                }
                else
                {
                    <li class="list-group-item text-center text-muted py-3">Henüz işlem kaydı yok.</li>
                }
            </ul>
        </div>
    </div>
</div>